{
  "name": "art-aesthete-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pdf": "vite --open /portfolio-pdf-preview",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "generate:portfolio-html": "tsx scripts/generatePortfolioPdf.mts",
    "generate:portfolio-pdf": "npm run generate:portfolio-html && vite preview --host 127.0.0.1 --port 4173 & PREVIEW_PID=$!; sleep 3; \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless=new --disable-gpu --virtual-time-budget=30000 --print-to-pdf=\"$PWD/dist/Art-Aesthete-Portfolio-Top10.pdf\" \"http://127.0.0.1:4173/portfolio-top10-source.html\"; kill $PREVIEW_PID",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:pages": "vitest run tests/pages",
    "test:data": "vitest run tests/unit/data-integrity.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "npm run build && tsx tests/smoke/smoke.mts",
    "test:smoke:mobile": "npm run build && tsx tests/smoke/smoke.mts --mobile",
    "test:live": "tsx tests/smoke/smoke.mts --url",
    "verify": "npm run typecheck && npm run test && npm run test:smoke:mobile"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.5.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.17",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "jsdom": "^28.1.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
